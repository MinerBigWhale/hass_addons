{
  "name": "DynDNS Updater",
  "version": "1.2",
  "slug": "dyndns_updater",
  "description": "Updates your Dynamic DNS and publishes public IP via MQTT.",
  "startup": "application",
  "boot": "auto",
  "options": {
    "username": "your-dyndns-user",
    "password": "your-dyndns-pass",
    "hostname": "yourdomain.dyndns.org",
    "base_url": "https://members.dyndns.org/nic/update?",
    "update_interval": 300
  },
  "schema": {
    "username": "str",
    "password": "str",
    "hostname": "str",
    "base_url": "url",
    "update_interval": "int"
  },
  "map": [
    "share:rw"
  ],
  "arch": ["aarch64", "amd64", "armv7", "i386"]
}
